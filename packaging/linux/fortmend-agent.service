[Unit]
Description=Fortmend endpoint protection agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/fortmend agent --config /var/lib/fortmend/agent.json
User=root
Restart=always
RestartSec=5
NoNewPrivileges=false
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
