[Unit]
Description=Aegis self-hosted security hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/aegis hub --data-dir /var/lib/aegis --tls-hosts localhost,127.0.0.1
User=aegis
Group=aegis
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aegis

[Install]
WantedBy=multi-user.target
